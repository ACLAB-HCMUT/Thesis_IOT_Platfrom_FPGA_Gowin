module i2c (
  clk,
  iic_scl,
  iic_sda,
  led1,
  led_io
)
;
input clk;
input iic_scl;
inout iic_sda;
output led1;
output led_io;
wire iic_scl_d;
wire iic_sda_in;
wire led_io_d;
wire led1_6;
wire led_io_d_6;
wire led_io_d_7;
wire iic_sda_5;
wire [7:0] get_data;
wire VCC;
wire GND;
  IBUF iic_scl_ibuf (
    .O(iic_scl_d),
    .I(iic_scl) 
);
  IOBUF iic_sda_iobuf (
    .O(iic_sda_in),
    .IO(iic_sda),
    .I(GND),
    .OEN(iic_sda_5) 
);
  OBUF led1_obuf (
    .O(led1),
    .I(led1_6) 
);
  OBUF led_io_obuf (
    .O(led_io),
    .I(led_io_d) 
);
  LUT4 led_io_d_s (
    .F(led_io_d),
    .I0(get_data[1]),
    .I1(get_data[0]),
    .I2(led_io_d_6),
    .I3(led_io_d_7) 
);
defparam led_io_d_s.INIT=16'h4000;
  LUT4 led1_s4 (
    .F(led1_6),
    .I0(get_data[0]),
    .I1(get_data[1]),
    .I2(led_io_d_6),
    .I3(led_io_d_7) 
);
defparam led1_s4.INIT=16'hEFFF;
  LUT4 led_io_d_s0 (
    .F(led_io_d_6),
    .I0(get_data[2]),
    .I1(get_data[3]),
    .I2(get_data[4]),
    .I3(get_data[5]) 
);
defparam led_io_d_s0.INIT=16'h0001;
  LUT2 led_io_d_s1 (
    .F(led_io_d_7),
    .I0(get_data[6]),
    .I1(get_data[7]) 
);
defparam led_io_d_s1.INIT=4'h1;
  iic_slave_design slave (
    .iic_sda_in(iic_sda_in),
    .iic_scl_d(iic_scl_d),
    .iic_sda_5(iic_sda_5),
    .get_data(get_data[7:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* i2c */
